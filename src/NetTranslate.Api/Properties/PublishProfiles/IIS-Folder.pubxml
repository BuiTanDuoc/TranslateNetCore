<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish NetTranslate.Api ra thư mục để copy lên IIS (Windows Server 2012 R2).
  - Release, win-x64, self-contained, KHÔNG single-file (IIS cần file dll/exe rời).
  - Web UI (web/) được build tự động trước khi publish, xem target BuildWebUi trong csproj.
  - Output: <repo>\publish\iis. Thư mục này bị xoá sạch trước mỗi lần publish.
  - models\ và appsettings.Production.json nằm ngoài project nên không bao giờ có trong output;
    khi copy lên server chỉ copy đè, đừng xoá thư mục site (data\models nằm trong đó).
  Chạy từ CLI: dotnet publish src/NetTranslate.Api/NetTranslate.Api.csproj -p:PublishProfile=IIS-Folder
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>..\..\publish\iis\</PublishUrl>
    <!-- PublishUrl dùng cho VS; PublishDir để dotnet publish (CLI) cũng ra cùng thư mục -->
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\iis\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <!-- Bật bước npm ci + npm run build (target BuildWebUi trong csproj) -->
    <BuildWebUi>true</BuildWebUi>
  </PropertyGroup>
</Project>
