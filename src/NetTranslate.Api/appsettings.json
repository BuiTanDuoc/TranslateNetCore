{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TrustForwardedHeaders": false,

  "ConnectionStrings": {
    "Default": "Data Source=data/nettranslate.db"
  },

  "Translate": {
    "CharLimit": 5000,
    "ReqLimit": 60,
    "BatchLimit": 50,
    "ApiKeysEnabled": true,
    "RequireApiKey": false,
    "AllowWebUiWithoutKey": true,
    "PivotLanguage": "en",
    "DefaultSource": "auto",
    "DefaultTarget": "vi",
    "DisableFilesTranslation": false,
    "FileSizeLimitMb": 10,
    "FileRetentionMinutes": 30
  },

  "Models": {
    "Path": "../../models",
    "Preload": false,
    "PreferQuantized": false,
    "BatchSize": 8,
    "IntraOpThreads": 0,
    "MaxConcurrency": 0
  },

  "Storage": {
    "FilesPath": "data/files"
  },

  "Admin": {
    "Token": ""
  }
}
